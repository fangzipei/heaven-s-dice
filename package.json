{
  "name": "heavens-dice",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A Kingdom Come: Deliverance 2 inspired rogue dice game.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "simulate": "node tools/balance.mjs 500",
    "auto-play": "node tools/auto-play.mjs",
    "dice:ev": "node tools/dice-ev.mjs",
    "codex": "node tools/build-codex.mjs",
    "export:dice": "node tools/export-dice-models.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
